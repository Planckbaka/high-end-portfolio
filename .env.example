# Portfolio Configuration
# Copy this file to .env.local and update with your actual values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yourportfolio.com
NEXT_PUBLIC_SITE_NAME=Akiwayne's Portfolio

# Contact Information (Optional - currently in data.ts)
# NEXT_PUBLIC_EMAIL=your@email.com
# NEXT_PUBLIC_PHONE=+1234567890

# Social Media (Optional - currently in data.ts)
# NEXT_PUBLIC_GITHUB=https://github.com/yourusername
# NEXT_PUBLIC_LINKEDIN=https://linkedin.com/in/yourusername
# NEXT_PUBLIC_TWITTER=https://twitter.com/yourusername

# Email (Cloudflare Email Routing, free)
# Binding SEND_EMAIL is declared in wrangler.toml. Set these as Worker vars/secrets:
# CONTACT_FROM = sender on your Email Routing domain; CONTACT_EMAIL = verified destination.
CONTACT_FROM=contact@your-domain.com
CONTACT_EMAIL=you@example.com


# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# CMS (if integrating later)
# CONTENTFUL_SPACE_ID=
# CONTENTFUL_ACCESS_TOKEN=

# Development
# NODE_ENV=development
