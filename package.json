{
  "name": "high-end-portfolio",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:articles": "node scripts/generate-articles-data.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "prebuild": "npm run generate:articles && npm run generate:og && npm run generate:labs",
    "build": "npm run prebuild && next build",
    "build:cf": "npm run prebuild && opennextjs-cloudflare build",
    "deploy": "npm run build:cf && wrangler deploy --env= --keep-vars",
    "deploy:prod": "npm run build:cf && wrangler deploy --env= --keep-vars",
    "preview": "wrangler dev",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate:placeholders": "node scripts/generate-project-placeholders.mjs",
    "generate:labs": "node scripts/package-labs.mjs",
    "test:content": "node --test scripts/article-pipeline.test.mjs",
    "check:content": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.560.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "gray-matter": "^4.0.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22"
  }
}
